

# BEGIN AMAFH STATIC WEBSITE
# AMAFH static production website. Review existing domain directives before merging.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Use the approved HTTPS origin, retaining the requested path and query.
  RewriteCond %{HTTP_HOST} ^www\.amafhdubai\.ae$ [NC]
  RewriteRule ^ https://amafhdubai.ae%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^amafhdubai\.ae$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://amafhdubai.ae%{REQUEST_URI} [R=301,L,NE]

  # Retain the earlier root language entry point.
  RewriteCond %{HTTP_HOST} ^amafhdubai\.ae$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)lang=ar(&|$) [NC]
  RewriteRule ^$ /ar/ [R=301,L,QSD]

  RewriteCond %{HTTP_HOST} ^amafhdubai\.ae$ [NC]
  RewriteRule ^$ /en/ [R=301,L]
</IfModule>
# END AMAFH STATIC WEBSITE

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
